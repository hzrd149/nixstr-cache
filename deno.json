{
  "version": "0.1.0",
  "license": "MIT",
  "unstable": ["no-legacy-abort"],
  "fmt": {
    "exclude": [".planning", "AGENTS.md", "NIP.md"]
  },
  "tasks": {
    "dev": "deno run --watch --allow-env --allow-net --allow-read --allow-write main.ts --config config.json",
    "start": "deno run --allow-env --allow-net --allow-read --allow-write main.ts",
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check main.ts tests/protocol/*.ts tests/integration/*.ts tests/e2e/*.ts",
    "test": "deno test --allow-read=.,/tmp --allow-write=/tmp tests/protocol",
    "test:address-pinning": "deno test --allow-net=127.0.0.1 --allow-read=.,/tmp --allow-write=/tmp tests/integration/address_pinning_test.ts",
    "test:integration": "deno test --allow-env --allow-net=127.0.0.1 --allow-read=.,/tmp --allow-write=/tmp tests/integration",
    "test:nix-e2e": "deno test --allow-run=nix,nix-store,deno --allow-net=127.0.0.1 --allow-read=.,/tmp --allow-write=/tmp tests/e2e/nix_substitution_test.ts tests/e2e/nix_publication_roundtrip_test.ts",
    "verify": "deno task fmt && deno task lint && deno task check && deno task test && deno task test:integration && deno task test:nix-e2e"
  },
  "imports": {
    "@grammyjs/debug": "jsr:@grammyjs/debug@0.3.1",
    "@msgpack/msgpack": "npm:@msgpack/msgpack@3.1.3",
    "@noble/hashes": "npm:@noble/hashes@2.3.0",
    "@noble/curves": "npm:@noble/curves@2.3.0",
    "@scure/base": "npm:@scure/base@2.3.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "applesauce-core": "npm:applesauce-core@0.0.0-next-20260813160224",
    "applesauce-common": "npm:applesauce-common@0.0.0-next-20260813160224",
    "applesauce-loaders": "npm:applesauce-loaders@0.0.0-next-20260813160224",
    "applesauce-relay": "npm:applesauce-relay@0.0.0-next-20260813160224",
    "applesauce-signers": "npm:applesauce-signers@0.0.0-next-20260813160224",
    "fast-check": "npm:fast-check@4.9.0",
    "nostr-tools": "npm:nostr-tools@2.24.1",
    "rxjs": "npm:rxjs@7.8.2"
  }
}
