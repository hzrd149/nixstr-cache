{
  "fmt": {
    "exclude": [".planning", "AGENTS.md", "NIP.md"]
  },
  "tasks": {
    "dev": "deno run --watch --allow-net main.ts",
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check main.ts",
    "test": "deno test",
    "test:address-pinning": "deno test --allow-net=127.0.0.1 --allow-read --allow-write tests/integration/address_pinning_test.ts",
    "test:integration": "deno test --allow-net=127.0.0.1 --allow-read --allow-write tests/integration",
    "test:nix-e2e": "deno test --allow-run=nix,nix-store,deno --allow-net=127.0.0.1 --allow-read --allow-write tests/e2e/nix_substitution_test.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@0.13.0",
    "@msgpack/msgpack": "npm:@msgpack/msgpack@3.1.3",
    "@noble/hashes": "npm:@noble/hashes@2.3.0",
    "@noble/curves": "npm:@noble/curves@2.3.0",
    "@scure/base": "npm:@scure/base@2.3.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "applesauce-core": "npm:applesauce-core@6.2.0",
    "applesauce-loaders": "npm:applesauce-loaders@6.2.0",
    "applesauce-relay": "npm:applesauce-relay@6.2.1",
    "fast-check": "npm:fast-check@4.9.0",
    "nostr-tools": "npm:nostr-tools@2.19.4",
    "rxjs": "npm:rxjs@7.8.2"
  }
}
